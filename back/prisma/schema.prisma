generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Tabla Usuarios
model Usuarios {
  id        String   @id @default(uuid())
  email     String   @unique
  nombre      String?
  puntos      Int
  fechaCreacion DateTime @default(now())
}